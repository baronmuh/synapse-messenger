#!/usr/bin/env bash
# Wrapper systemd de la passerelle A2A (SPEC_PRODUCTION §1).
#
# Reads the agent secrets (password + token) from the directory
# de secrets et les passe au CLI sur stdin — JAMAIS en argument de
# command, never in the environment (project rule).
#
# Usage : synapse-a2a-systemd <agent> [port]
# Production paths can be overridden via environment
# (SYNAPSE_VENV_BIN, SYNAPSE_CONFIG, SYNAPSE_SECRETS_DIR) — the units
# generated by install.sh use the defaults.
set -euo pipefail

AGENT="${1:?agent requis (ex. support)}"
PORT="${2:-8090}"

VENV_BIN="${SYNAPSE_VENV_BIN:-/opt/synapse/venv/bin}"
CONFIG="${SYNAPSE_CONFIG:-/etc/synapse/config.json}"
SECRETS_DIR="${SYNAPSE_SECRETS_DIR:-/etc/synapse/secrets}"

PASSWORD_FILE="${SECRETS_DIR}/a2a-${AGENT}.password"
TOKEN_FILE="${SECRETS_DIR}/a2a-${AGENT}.token"

if [[ ! -f "$PASSWORD_FILE" || ! -f "$TOKEN_FILE" ]]; then
    echo "synapse-a2a-systemd: secrets absents pour l'agent '${AGENT}' " \
         "(attendus : ${PASSWORD_FILE}, ${TOKEN_FILE})" >&2
    exit 1
fi

# cat concatenates the two lines (password then token); the CLI reads the
# first line as the password and the second as the token.
cat "$PASSWORD_FILE" "$TOKEN_FILE" \
| exec "$VENV_BIN/synapse" a2a start --foreground \
    --agent-name "$AGENT" --port "$PORT" \
    --config "$CONFIG" \
    --password-stdin --token-stdin
